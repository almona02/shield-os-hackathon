# Supabase — append-only ledger (trigger blocks UPDATE/DELETE)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Meta Model API (same key for Muse Spark + SAM 3.1) — from https://dev.meta.ai
META_API_KEY=your_key_from_dev.meta.ai
META_MODEL=muse-spark-1.3
META_LLAMA_MODEL=muse-spark-1.3
META_LLAMA_URL=https://api.meta.ai/v1/chat/completions
META_SAM_MODEL=sam-3.1
META_SAM_URL=https://api.meta.ai/v1/responses
