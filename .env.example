# Supabase — append-only ledger (trigger blocks UPDATE/DELETE)
# Configure and verify in your deployment; missing configuration uses memory.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_ANON_KEY=your_anon_key

# Select a model available in your account. No live call is guaranteed by configuration.
META_API_KEY=your_key_from_dev.meta.ai
META_MODEL=muse-spark-1.3
META_LLAMA_URL=https://api.meta.ai/v1/responses
# Existing Llama deployments can retain their model and chat/completions endpoint.
META_SAM_MODEL=sam-3.1
META_SAM_URL=https://api.meta.ai/v1/responses
