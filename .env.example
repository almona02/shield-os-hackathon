# Supabase — append-only ledger (trigger blocks UPDATE/DELETE)
# Production already uses this; MemoryLogStore is local fallback only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Meta Model API — same Bearer key for Llama + SAM 3.1 (dev.meta.ai)
META_API_KEY=your_key_from_dev.meta.ai
META_MODEL=llama-4-maverick
META_LLAMA_MODEL=llama-4-maverick
META_LLAMA_URL=https://api.llama.com/v1/chat/completions
META_SAM_MODEL=sam-3.1
META_SAM_URL=https://api.meta.ai/v1/responses
